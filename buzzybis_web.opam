# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Static site generator and local HTTP server for buzzybis.web"
description: """
Fetches Typst blog posts from GitHub, compiles them to HTML, generates the
   project and home pages consumed by Soupault, and serves the built site
   locally with on-demand PDF compilation."""
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.13"}
  "yojson"
  "uri"
  "lambdasoup"
  "async_log"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
